# GameNest 2.0 settings, NAMES ONLY (prod_v2, 2026-11-15). Every value is in compose/docker-compose.v2.yml or the images; nothing here is
# secret and nothing here is read by Docker. Never set TEST_HOOKS (LAN only). Secrets are never environment variables: they are files
# in /home/ubuntu/secrets/gamenest-v2/{wallet,appstore,play} (mode 0700 folders), mounted into the wallet only.

# every room server
AGE_DIR=
BASE_PATH=
DATA_DIR=
NODE_ENV=
PING_INTERVAL_MS=
PING_TIMEOUT_MS=
PLUS_STATS_FILE=
POKER_MAX_SEATS=
PORT=
PUSH_URL=
RANK_DIR=
REACTIONS_DEFAULT=
STATS_DIR=
WALLET_PUBKEYS_FILE=

# the images (base and chess) set these; listed so nobody adds them by hand
MODERATION_MODEL_DIR=
SPIES_MODEL_DIR=
NODE_PATH=
MAIA_MODEL=

# the wallet (the image sets the first eight)
HOST=
PORT=
BASE_PATH=
TRUST_PROXY=
WALLET_DATA_DIR=
WALLET_BACKUP_DIR=
WALLET_CACHE_DIR=
APPSTORE_DIR=
ROSTER_SERVERS=
SEASON_START=

# later, by the owner and the lead only (see OWNER_STEPS.md)
WALLET_ENFORCE=   # 1 = only a wallet-signed token makes Plus (after 48 clean hours of observe)
GN_INTERNAL_SECRET=   # Treat the room's roster call; unset = the route answers 404 (Treat the room is off in the app)
OPENROUTER_KEY=   # Word Spies' bots' language model (paid per call); unset = the MiniLM bots
HF_TOKEN=
STATS_KEY=
